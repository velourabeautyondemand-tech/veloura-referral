# PostgreSQL database used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/veloura_referrals"

# Authentication
# Generate a secret of at least 32 random characters.
JWT_SECRET="replace-with-a-secure-random-secret"
ADMIN_EMAILS="admin@velourabeautyondemand.com"

# OTP email delivery through Resend
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="VÉLOURA <login@velourabeautyondemand.com>"

# Website URLs and support text used in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_NAME="VÉLOURA"
PLATFORM_SUPPORT_EMAIL="support@velourabeautyondemand.com"

# Existing platform administration settings
ADMIN_EMAILS="admin@velourabeautyondemand.com"
NODE_ENV="development"
